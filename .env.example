# PULP configuration. Copy to .env (never committed) and change every "change-me".
#   cp .env.example .env
# Every variable the stack reads is listed here. A work package that adds a
# variable adds it to this file in the same pull request.
# Hostnames are Docker Compose service names, as seen from inside the containers.

# --- General -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=pulp
LOG_LEVEL=INFO

# --- Simulation (WP-04) ------------------------------------------------------
# Seed for the random generator: the same seed gives the same run.
SIM_SEED=42
# Simulation clock speed: 1 is real time, 60 runs one simulated minute per second.
SIM_TIME_SCALE=1

# --- UNS broker: Mosquitto (WP-02) -------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_USERNAME=pulp
MQTT_PASSWORD=change-me

# --- Historian and journal: TimescaleDB (WP-02) ------------------------------
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=pulp
POSTGRES_USER=pulp
POSTGRES_PASSWORD=change-me

# --- Grafana (WP-02) ---------------------------------------------------------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- ERP and PLM: Odoo with OdooPLM (WP-10) ----------------------------------
ODOO_URL=http://odoo:8069
ODOO_DB=pulp
ODOO_USER=admin
ODOO_PASSWORD=change-me
# Password of Odoo's own PostgreSQL, separate from the historian's.
ODOO_DB_PASSWORD=change-me

# --- Embeddings: Ollama on Windows (WP-18) -----------------------------------
OLLAMA_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text

# --- Production agent (WP-19) ------------------------------------------------
# Provider and model are still open decisions (docs/spec.md, "Risks and open decisions").
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
